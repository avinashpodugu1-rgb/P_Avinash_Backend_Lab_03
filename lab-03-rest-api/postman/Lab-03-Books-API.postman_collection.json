            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
              "pm.test('Error message is Title is required', function () {",
              "  var res = pm.response.json();",
              "  pm.expect(res.message).to.eql('Title is required');",
              "});"
            ]
